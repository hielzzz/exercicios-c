#include <stdio.h>

int main() {
    int num1, num2;

    printf("Informe o primeiro número: ");
    scanf("%d", &num1);

    printf("Informe o segundo número: ");
    scanf("%d", &num2);
  
    if(num1 < num2) {
      printf("Ordem crescente: %d, %d\n", num1, num2);
    }else if (num2 < num1) {
      printf("Ordem crescente: %d, %d\n", num2, num1);
    }else {
      printf("Os números são iguais ");
    }
  
    return 0;
}
